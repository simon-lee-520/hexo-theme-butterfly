- var globalPageType = 'landing'
- var hideAside = 'hide-aside'

doctype html
html(lang=config.language data-theme=theme.display_mode class=hideAside)
  head
    include includes/head.pug
    link(rel='stylesheet' href=url_for('/css/landing.css') media='all')
    script(type='importmap').
      {
        "imports": {
          "three": "https://cdn.jsdelivr.net/npm/three@0.172.0/build/three.module.js",
          "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.172.0/examples/jsm/",
          "@pixiv/three-vrm": "https://cdn.jsdelivr.net/npm/@pixiv/three-vrm@3.3.6/lib/three-vrm.module.js"
        }
      }
  body.page-landing
    != partial('includes/loading/index', {}, { cache: true })

    #landing
      #landing-foreground
        section.act-1.landing-hero#landing-hero
          .landing-hero-inner
            img.landing-avatar(src=url_for(theme.avatar.img) alt=config.author)
            h1.landing-name= "Welcome To Simon's Home"
            if theme.subtitle && theme.subtitle.enable
              #landing-subtitle
                span#subtitle
            a.landing-cta(href=url_for('/blog/') target='_blank' rel='noopener noreferrer' data-pjax='false')
              span 進入博客
              i.fas.fa-arrow-right
            a.landing-scroll-hint(href='#landing-content' aria-label='向下滚动')
              i.fas.fa-chevron-down

        section.act-2.act-spacer#landing-act-2(aria-hidden='true')

        section.act-3#landing-content.landing-content
          .landing-content-inner
            != page.content

      footer.landing-footer
        - const landingYear = new Date().getFullYear()
        span © #{landingYear} #{config.author}
        span.landing-footer-sep ·
        a(href=url_for('/blog/') target='_blank' rel='noopener noreferrer' data-pjax='false') 技术博客

    script(src=url_for(theme.asset.utils))
    if theme.subtitle && theme.subtitle.enable
      - var loadSubJs = true
      include includes/third-party/subtitle.pug
    script(type='module' src=url_for('/js/bg-tech.js'))
    script.
      document.documentElement.setAttribute('data-theme', 'dark')
